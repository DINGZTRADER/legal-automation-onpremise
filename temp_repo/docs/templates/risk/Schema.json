{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Risk Analysis Report Schema",
  "type": "object",
  "required": ["report_id", "file_id", "overall_grade", "findings"],
  "properties": {
    "report_id": {
      "type": "string",
      "format": "uuid"
    },
    "file_id": {
      "type": "string",
      "format": "uuid"
    },
    "matter_id": {
      "type": "string",
      "format": "uuid"
    },
    "filename": {
      "type": "string"
    },
    "analysis_date": {
      "type": "string",
      "format": "date-time"
    },
    "overall_grade": {
      "type": "string",
      "enum": ["High", "Medium", "Low"]
    },
    "executive_summary": {
      "type": "string",
      "minLength": 150,
      "maxLength": 500
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "severity", "title", "rationale", "evidence", "suggestion"],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "Commercial/Financial",
              "Scope & Deliverables",
              "Time",
              "Liability & Remedies",
              "Term & Termination",
              "Compliance/Regulatory",
              "Property/Land",
              "Dispute Resolution",
              "IP & Confidentiality",
              "Counterparty Risk",
              "Operational Risk",
              "Ambiguity/Missing"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "rationale": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "file_path": {"type": "string"},
              "page_number": {"type": "integer"},
              "section": {"type": "string"},
              "snippet": {"type": "string", "maxLength": 300}
            }
          },
          "suggestion": {
            "type": "string"
          }
        }
      }
    },
    "entities": {
      "type": "object",
      "properties": {
        "parties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "role": {"type": "string"}
            }
          }
        },
        "deadlines": {"type": "array"},
        "financial_terms": {"type": "array"},
        "properties": {"type": "array"},
        "governing_law": {"type": "string"},
        "jurisdiction": {"type": "string"},
        "dispute_resolution": {"type": "string"}
      }
    },
    "lawyer_conclusion": {
      "type": "object",
      "properties": {
        "text": {"type": "string"},
        "lawyer_name": {"type": "string"},
        "lawyer_id": {"type": "string"},
        "concluded_at": {"type": "string", "format": "date-time"},
        "signature_hash": {"type": "string"}
      }
    }
  }
}
